# Copie este arquivo para `.env` e preencha os valores.
# O `.env` está no .gitignore — nunca commite o arquivo real.

# String de conexão com o PostgreSQL (Render, Railway, Neon, local...)
DATABASE_URL=postgresql://USER:SENHA@HOST:5432/NOME_DO_BANCO

# Hash bcrypt da senha de administrador (gerado com `node hash.js sua_senha`)
PASSWORD_HASH=$2b$10$...

# Integração com a Twitch (opcional — sem ela /twitch-status responde 503)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Porta do servidor
PORT=3000
